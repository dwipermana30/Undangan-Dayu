{
  "rules": {
    ".read": false,
    ".write": false,
    "ucapan": {
      ".read": true,
      ".indexOn": ["waktu"],
      "$commentId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['nama', 'kehadiran', 'pesan', 'waktu'])",
        "nama": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "kehadiran": {
          ".validate": "newData.isString() && (newData.val() === 'Hadir' || newData.val() === 'Tidak Hadir')"
        },
        "pesan": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "waktu": {
          ".validate": "newData.isNumber() && newData.val() >= now - 86400000 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
